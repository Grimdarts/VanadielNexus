  "guide_observations": [
    {
      "section": "Currency",
      "observation": "BG Community Bard Guide permalink oldid781483; browser footer last edited 2026-10-30 00:55. Briko node355 footer 2022-05-10 and internal 2022-04-01. Date is not proof that every table or opinion is current.",
      "observation_sha256": "db373399cff2235eaabdfd7fe38603a2db591f6390dc06c68d931af761ff7008"
    },
    {
      "section": "Instruments / Playability",
      "observation": "Extra song capacity, song potency and instrument-locked access are distinct. Terpander supplies one slot; Daurdabla99 supplies two; capacity effects do not stack. Establish low-duration dummy songs then replace them using potency gear before expiry; song loss/dispel/death may require reestablishing slots. Clarion Call is separate.",
      "observation_sha256": "4dfbcdb018f1ab7d2b61059ff42dbf71cc234dbb63e5c04747334e0975adcfe9"
    },
    {
      "section": "Singing / Song+ Effects",
      "observation": "Use matching song-family pieces: Fili head Madrigal, body Minuet, hands March, legs Ballad, feet Scherzo; Intarabus base Madrigal/Prelude; Brioso head Paeon and hands Lullaby. Mousai pieces address Etude/Threnody/Carol/Minne/Mambo. Ballad and Minne legs displace Inyanga duration; Scherzo/Mambo feet displace Brioso duration.",
      "observation_sha256": "1fdd520850fadc4eac6a84ef807b382bac4dcfe32cd2548dadba39a842611778"
    },
    {
      "section": "Song Accuracy / Horde Lullaby II",
      "observation": "Accuracy uses CHR, magic accuracy, Singing and the equipped instrument skill; exact relative weighting uncertain. String skill affects Horde Lullaby II radius, with separate ML/augment/skill prerequisites; wind skill does not establish that radius.",
      "observation_sha256": "f904b087e5905817ccc99f720368e84607f6cb628ed32e6ed7551658b5678d58"
    },
    {
      "section": "Fast Cast",
      "observation": "Song spellcasting-time reduction and Fast Cast are different; the former does not itself reduce recast. Generic magic, ordinary songs and instrument-locked Honor March need explicit contexts; title totals/550JP gift not certified for substitutions.",
      "observation_sha256": "314235e137397a438a3826b9e8189192dbd91bbf199d6d1610e18d2db3476412"
    },
    {
      "section": "Weapons / Offhands",
      "observation": "Kali base duration is distinct from its Path D skills. Guide lists Naegling and shields as useful choices; source dual-wield Centovente accuracy/TP bonus and Carnwenhan aftermath do not transfer to Nexus single-sword/shield.",
      "observation_sha256": "22db3c568f0b2be2ece3f08058e51781367a26592cf9e335976041c66989a480"
    },
    {
      "section": "Instruments / REMAP / Special Note",
      "observation": "Fully upgraded Loughnashade combines song potency/capacity and Aria access; unspecified stages cannot inherit final-stage effects. Miracle Cheer fixes duration under separate rules. Neither is authored in this bounded batch.",
      "observation_sha256": "797dcb6b1e8c552996566ecbf66db2ee9715d9ccf69e8d30582871e5ee5525f3"
    },
    {
      "section": "Engaged / WS / Briko augment notes",
      "observation": "BG TP Linos asks for Accuracy+Attack15, Store TP4, Quadruple Attack3. Briko TP cape asks for DEX30, Accuracy+Attack20, Store TP10, DT-5. Briko Savage Blade Linos asks Accuracy+Attack15, STR8, WSD3; cape STR30, Accuracy+Attack20, WSD10, DT-5; Nyame Path B. These are separate copies/requirements, not one generic Linos/cape.",
      "observation_sha256": "c150173f36cf5ac4d3d8f2aeee0832ac44daa62c74775c6b7ddebd0014aafe03"
    },
    {
      "section": "Fast Cast / Song Accuracy / Briko notes",
      "observation": "FC cape requires FC10 and generic FC Linos FC6. BG song accuracy cape requires CHR20 and magic accuracy20+10. No optional augments from an owned copy are assumed on base targets.",
      "observation_sha256": "796b0d2402e83f8748879be858795bb15c99a2a0f72d44dd09eaa0764fa9c406"
    },
    {
